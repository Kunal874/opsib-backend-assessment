# Every setting the service reads (from environment variables), with its default.
# Nothing loads this file automatically — export a variable only if you need to change it.
DATABASE_URL=postgresql://opsib:opsib@localhost:55432/opsib
TEST_DATABASE_URL=postgresql://opsib:opsib@localhost:55432/opsib_test
TENANT_ID=demo-retailer
# Frozen business "now" for all scenario logic (must include a UTC offset)
EVALUATION_TIME=2026-10-16T15:00:00+05:30
# Shortfall raised only when expected - received > tolerance (base units)
SHORTFALL_TOLERANCE=0
# Availability samples older than this are not trusted for routing
WORKFORCE_MAX_SAMPLE_AGE_MINUTES=30
# Task due time = evaluation time + SLA
TASK_SLA_HOURS=24
LOG_LEVEL=INFO
